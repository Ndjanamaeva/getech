# Variables d'environnement — GENESYS Cameroon
# Copiez ce fichier en .env et renseignez les valeurs.

# Supabase (pré-rempli automatiquement dans Bolt)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fournisseur d'e-mail (optionnel — pour notifications de nouvelles demandes)
# Utilisé uniquement côté serveur (Edge Functions). Jamais exposé dans le navigateur.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM=contact@genesys-cameroun.com
# ADMIN_NOTIFY_EMAIL=admin@genesys-cameroun.com
